# ──────────────────────────────────────────────────────────────
#  .env.example
#  Copy to .env → fill secrets → NEVER commit the real file
# ──────────────────────────────────────────────────────────────
#  1. ProtonMail Bridge (internal Docker network)
# ──────────────────────────────────────────────────────────────
BRIDGE_HOST=cortex_bridge
BRIDGE_SMTP_PORT=25
BRIDGE_IMAP_PORT=143

# Fill these ONCE via:
# docker exec -it cortex_bridge protonmail-bridge --cli → login → exit
BRIDGE_USERNAME=you@protonmail.com
BRIDGE_PASSWORD=your-16-char-app-password
BRIDGE_DISPLAY="Scheduled Bot"

# Global kill-switch
SEND_EMAIL=1
CORTEX_DRY_RUN=0   # 1 = never send real mail

# ──────────────────────────────────────────────────────────────
#  2. ProtonVPN (gluetun sidecar — scraper IP rotation)
#     Generate a WireGuard config at:
#     account.protonvpn.com → Downloads → WireGuard configuration
#     Copy PrivateKey and Address from the [Interface] block.
# ──────────────────────────────────────────────────────────────
PROTON_WG_PRIVATE_KEY=
PROTON_WG_ADDRESSES=10.2.0.2/32
PROTON_VPN_COUNTRIES=United States,Canada,Switzerland,Netherlands
# Proton *account* login (not the WireGuard key). Only used by gluetun's server
# list updater, which silently skips ProtonVPN entirely when these are empty —
# leaving the list frozen at the snapshot baked into the gluetun image. Set them
# and `docker compose up -d vpn`, then confirm the update landed with:
#   docker compose logs vpn | grep -i "updating Protonvpn"
PROTON_API_EMAIL=
PROTON_API_PASSWORD=
CAREER_WATCH_PROXY_URL=http://vpn:8888
VPN_CONTROL_URL=http://vpn:8000
EVENT_WATCH_PROXY_URL=http://vpn:8888   # set = event_watch proxies AND health-checks
EVENT_WATCH_ROTATE_VPN=0    # rotation buys nothing for a public feed
CAREER_WATCH_ROTATE_VPN=1   # 0 = reuse the current exit IP instead of rotating per run
#CAREER_WATCH_VERIFY_URL=   # URL fetched through the proxy to prove an exit works.
                            # Unset = engine.DEFAULT_VERIFY_URL (a real job-board API).
                            # Do not point this at a neutral connectivity check: that
                            # proves the tunnel carries traffic but not that a board
                            # will answer, which is how a blocked exit scrapes zero
                            # and still logs ok=true.
#VPN_ROTATE_TIMEOUT=120     # seconds to wait for the tunnel after a rotation restart.
                            # Unset = vpn_client.DEFAULT_ROTATE_TIMEOUT (120). Leave it
                            # alone: 1518 surveyed exits (2026-08-12..16) put the median
                            # switch at 16 s and p95 at 64 s, and because
                            # switch_until_usable retries 3×, the ceiling barely moves
                            # run-level reliability — 120 s fails 0.038% of runs, 180 s
                            # fails 0.018% but triples worst-case stall to 9 minutes.
                            # Watch the restarts[] field on vpn_switch activity events.

# ──────────────────────────────────────────────────────────────
#  3. Core paths (match your volumes)
# ──────────────────────────────────────────────────────────────
CONFIG_PATH=/app/local/config.json
LOG_DIR=/app/local/logs
LOG_LEVEL=INFO

ACTIVITY_LOG_PREFIX=activity
ERROR_LOG_PREFIX=error
ACTIVITY_LOG_MAX_BYTES=10485760   # 10 MiB → auto-rotate

# ──────────────────────────────────────────────────────────────
#  4. IMAP command listener
# ──────────────────────────────────────────────────────────────
COMMANDS_FOLDER=Labels/Command
COMMAND_ALLOWED_DOMAINS=protonmail.com,gmail.com,yourdomain.com

# ──────────────────────────────────────────────────────────────
#  5. OpenAI
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL_BIBLE=gpt-5-mini
OPENAI_TEMP_BIBLE=1
LLM_MD_ENABLE=1
LLM_MD_DIR=/app/local/state/llm   # archive dir for per-run LLM .md files
LLM_MD_MAX=5

# ──────────────────────────────────────────────────────────────
#  6. Weather (Open-Meteo)
# ──────────────────────────────────────────────────────────────
DEFAULT_LAT=37.7749
DEFAULT_LON=-122.4194
DEFAULT_UNITS=imperial   # or metric

# ──────────────────────────────────────────────────────────────
#  7. Scraper users
# ──────────────────────────────────────────────────────────────
SCRAPER_USER_1="The Archivist"
SCRAPER_USER_2="Sidekick"

# ──────────────────────────────────────────────────────────────
#  8. Sonos / network
# ──────────────────────────────────────────────────────────────
NAS_IP=192.168.1.100
COORDINATOR_IP=192.168.1.200

# ──────────────────────────────────────────────────────────────
#  9. Bible Email Config
# ──────────────────────────────────────────────────────────────
BIBLE_PLAN_PRAYER_COUNT=3   # prayer topics shown per day (default 3)
BIBLE_PLAN_EMAILS=you@mail.com,mom@aol.com

# ──────────────────────────────────────────────────────────────
#  10. Timezone (container + scheduler)
# ──────────────────────────────────────────────────────────────
TZ=America/Los_Angeles
